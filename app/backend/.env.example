# Copy this to .env for local dev, or set these as environment variables
# in your hosting provider's dashboard (e.g. Render) for production.
# Nothing here is required to just run the app locally except GEMINI_API_KEY —
# every other var has a safe local-dev fallback (see server.js).

# --- Always required ---
GEMINI_API_KEY=

# --- Google Contacts integration (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Deployment (leave unset for local dev) ---
# Full Postgres connection string, e.g. from Supabase's "Connection string"
# page (use the pooled "Transaction" connection string, port 6543).
# Unset locally -> connects to the local "filmmaking_app" database instead.
DATABASE_URL=

# This backend's own public URL once deployed (e.g. https://your-app.onrender.com).
# Used to build the Google OAuth redirect URI. Unset locally -> http://localhost:4000.
BACKEND_URL=

# The deployed frontend's URL (e.g. https://your-app.vercel.app). Required
# for CORS + cookies to work once frontend and backend are on different
# domains. Unset locally -> http://localhost:5173.
FRONTEND_URL=

# Supabase Storage, for crew/cast photos. Required in production — Render's
# free tier has no persistent disk, so local-disk storage would lose every
# photo on the next deploy or restart. Unset locally -> saves to ./uploads/
# on disk instead (fine for local dev, not for anything you deploy).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Optional, defaults to "crew-photos" — must be a bucket you created in the
# Supabase dashboard (Storage -> New bucket -> Public bucket) if you deploy.
SUPABASE_STORAGE_BUCKET=

# Marks this as a production environment — makes session cookies
# SameSite=None; Secure, required for cross-domain cookies (Vercel <-> Render).
NODE_ENV=
